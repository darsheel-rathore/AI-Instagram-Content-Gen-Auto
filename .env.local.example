# Clerk auth — REQUIRED, middleware.ts blocks every route without it.
# https://dashboard.clerk.com → your app → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/login
# Signed-in users also need publicMetadata.role = "admin" set on their Clerk
# user (Clerk dashboard → Users → your user → Metadata), or middleware.ts
# redirects them to /unauthorized.

# Upstash Redis — persists cache/settings/usage/recycle-bin data across
# deploys. Without this, storage falls back to local JSON files under data/
# (or /tmp/data on Vercel, which is wiped on every cold start/redeploy).
# https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Your Instagram username (without @)
NEXT_PUBLIC_INSTAGRAM_USERNAME=your_instagram_username

# Apify token — https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# AI provider for content ideas: anthropic | openai | gemini (default: anthropic)
AI_PROVIDER=anthropic

# Anthropic key — https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI key (also used for transcription) — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Gemini key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Quora session cookies — REQUIRED only if you use the Quora competitor scraper.
# Get them by opening quora.com in your browser while signed in:
#   1. Open DevTools → Application → Cookies → https://www.quora.com
#   2. Copy the cookie string OR export as JSON array
#   3. Paste here as a single line (quoted)
# Cookies expire periodically — refresh this value when Quora scrapes start failing.
QUORA_COOKIES=
